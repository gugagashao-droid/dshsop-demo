{
  "_note": "项目差异只写在这里，不改 .github/workflows/sop.yml。命令用 argv 数组；ci-run.py 忽略下划线开头的键。占位符没填时 CI 必须红。",
  "machine": [
    { "name": "门禁一致性（文档/结构/模型分离）", "cmd": ["python", "scripts/gate.py", "--ci"] },
    { "name": "字节码编译检查", "cmd": ["python", "-m", "compileall", "-q", "scripts"] }
  ],
  "platform": [
    { "name": "多平台 Python 运行时检查", "cmd": ["python", "-c", "import platform, sys; print(platform.platform(), sys.version.split()[0])"] }
  ],
  "ai": [
    { "name": "spec 视角", "cmd": ["python", "scripts/ai_review.py", "--axis", "spec", "--out", ".review/spec.yaml"] },
    { "name": "compat 视角", "cmd": ["python", "scripts/ai_review.py", "--axis", "compat", "--out", ".review/compat.yaml"] },
    { "name": "impact 视角", "cmd": ["python", "scripts/ai_review.py", "--axis", "impact", "--out", ".review/impact.yaml"] },
    { "name": "合并三份 findings", "cmd": ["python", "scripts/merge-findings.py", "merge", "--inputs", ".review/spec.yaml", ".review/compat.yaml", ".review/impact.yaml", "--outdir", ".review"] },
    { "name": "算出下一轮", "cmd": ["python", "scripts/review-state.py", "next-round", "--out", ".review/next-round"] },
    { "name": "轮次记账", "cmd": ["python", "scripts/review-state.py", "record", "--round", "@.review/next-round", "--important", "@.review/important-count", "--axes", "spec,standards"] }
  ]
}
