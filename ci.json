{
  "_note": "项目差异只写在这里，不改 .github/workflows/sop.yml。命令用 argv 数组；ci-run.py 忽略下划线开头的键。占位符没填时 CI 必须红。@相对路径 会在执行前被替换成该文件内容（由前一步落盘）。",
  "machine": [
    { "name": "门禁一致性（文档/结构/模型分离）", "cmd": ["python", "scripts/gate.py", "--ci"] },
    { "name": "静态代码检查", "cmd": ["<填写：静态检查命令>"] },
    { "name": "全量单元与集成测试", "cmd": ["<填写：全量测试命令>"] },
    { "name": "依赖安全扫描", "cmd": ["<填写：依赖扫描命令>"] },
    { "name": "基础性能基准", "cmd": ["<填写：性能基准命令>"] }
  ],
  "platform": [
    { "name": "多平台构建验证", "cmd": ["<填写：构建命令>"] },
    { "name": "兼容性测试", "cmd": ["<填写：兼容性测试命令>"] }
  ],
  "ai": [
    { "name": "spec 视角", "cmd": ["<填写：输出 .review/spec.yaml 的无头调用>"] },
    { "name": "compat 视角", "cmd": ["<填写：输出 .review/compat.yaml 的无头调用>"] },
    { "name": "impact 视角", "cmd": ["<填写：输出 .review/impact.yaml 的无头调用>"] },
    { "name": "合并三份 findings", "cmd": ["python", "scripts/merge-findings.py", "merge", "--inputs", ".review/spec.yaml", ".review/compat.yaml", ".review/impact.yaml", "--outdir", ".review"] },
    { "name": "算出下一轮", "cmd": ["python", "scripts/review-state.py", "next-round", "--out", ".review/next-round"] },
    { "name": "轮次记账", "cmd": ["python", "scripts/review-state.py", "record", "--round", "@.review/next-round", "--important", "@.review/important-count", "--axes", "spec,standards"] }
  ]
}
